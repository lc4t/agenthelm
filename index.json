      "version": "1.6.0",
      "status": "stable",
      "entrypoints": {
        "agent": "./plugins/project-orchestrator/skills/project-orchestrator/SKILL.md",
        "metadata": "./plugins/project-orchestrator/plugin.json",
        "runtime": "./plugins/project-orchestrator/runtime/memory.py"
      }
    },
    {
      "id": "agent-pack",
      "name": "agent-pack / Agent 扩展能力管理",
      "description": "在项目与 Codex / Cursor / Claude 之间盘点、校验、安装、同步、迁移与对账 Plugin、Skill、MCP。",
      "version": "1.5.1",
      "status": "stable",
      "entrypoints": {
        "agent": "./plugins/agent-pack/skills/agent-pack/SKILL.md",
        "metadata": "./plugins/agent-pack/plugin.json",
        "mcp": "./plugins/agent-pack/mcp.json",
        "reference": "./plugins/agent-pack/references/capability-config.md"
      }
    },
    {
      "id": "opinion-manager",
      "name": "opinion-manager / Agent 行为规则管理",
      "description": "三个首次主入口与可选记忆候选；一次内容确认后分别保存 Profile、正文与锁，支持精确版本和个人修改保护；可选的分层加载与项目私有的候选、灰度记账。",
      "version": "0.4.0",
      "status": "experimental",
      "entrypoints": {
        "agent": "./plugins/opinion-manager/skills/opinion-manager/SKILL.md",
        "metadata": "./plugins/opinion-manager/plugin.json",
        "runtime": "./plugins/opinion-manager/runtime/opinion_manager.py"
