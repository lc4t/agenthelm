{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Opinion rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "slot", "title", "level", "scopes", "text"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "slot": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "title": {"$ref": "#/$defs/localizedText"},
    "level": {"enum": ["required", "preferred"]},
    "scopes": {"$ref": "#/$defs/localizedScopes"},
    "text": {"$ref": "#/$defs/localizedText"},
    "trigger": {"$ref": "#/$defs/localizedText"},
    "purpose": {"$ref": "#/$defs/localizedText"},
    "exclude": {"$ref": "#/$defs/localizedText"}
  },
  "$defs": {
    "localizedText": {
      "description": "A plain string is the legacy form and counts as zh; {zh, en} supplies one or both languages.",
      "oneOf": [
        {"type": "string", "pattern": "\\S"},
        {"type": "object", "additionalProperties": false, "minProperties": 1,
         "properties": {"zh": {"type": "string", "pattern": "\\S"}, "en": {"type": "string", "pattern": "\\S"}}}
      ]
    },
    "localizedScopes": {
      "oneOf": [
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
        {"type": "object", "additionalProperties": false, "minProperties": 1,
         "properties": {
           "zh": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}},
           "en": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}}}
      ]
    }
  }
}
