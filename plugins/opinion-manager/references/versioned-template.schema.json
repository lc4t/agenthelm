{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Opinion template",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "variant", "version", "name", "description", "scopes", "rules"],
  "properties": {
    "family": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "variant": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name": {"$ref": "rule.schema.json#/$defs/localizedText"},
    "description": {"$ref": "rule.schema.json#/$defs/localizedText"},
    "scopes": {"$ref": "rule.schema.json#/$defs/localizedScopes"},
    "rules": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
    },
    "loading": {"$ref": "profile.schema.json#/$defs/tagLoading", "description": "可选：本模板规则的标签选择声明；always 与 members 只能引用本模板的规则编号。选择模板时由 profile 预览物化为 Profile 的 loading（schema 2.2）。"}
  }
}
