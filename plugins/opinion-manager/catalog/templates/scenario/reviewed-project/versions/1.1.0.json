      ],
      "om.test-evidence": [
        "decisions"
      ],
      "om.versioned-files": [
        "files"
      ],
      "om.concrete-titles": [
        "files"
      ],
      "om.portable-files": [
        "files"
      ],
      "om.consistent-items": [
        "files"
      ],
      "om.report-context": [
        "reports"
      ],
      "om.report-formats": [
        "reports"
      ],
      "om.report-review": [
        "reports"
      ],
      "om.device-readable": [
        "reports"
      ],
      "om.semantic-wrap": [
        "reports"
      ],
      "om.editable-diagrams": [
        "reports"
      ],
      "om.rules-tools": [
        "maintenance"
      ],
      "om.maintenance-chinese": [
        "maintenance"
      ]
    }
  }
