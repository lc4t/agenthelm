{
  "family": "scenario",
  "variant": "reviewed-project",
  "version": "1.1.0",
  "name": {
    "zh": "完整分析与项目交付组合",
    "en": "Complete analysis with project delivery"
  },
  "description": {
    "zh": "用途：需要完整分析、版本化交付及中文维护的项目任务。 不适用：未选择此偏好的项目；需要专属业务模板的任务。 这是可选择的行为偏好，不代表普遍最优做法。",
    "en": "Use: project tasks needing complete analysis, versioned delivery and Chinese maintenance. Not for: projects that did not choose this preference; tasks needing business-specific templates. This is a selectable behavior preference, not a universally best practice."
  },
  "scopes": {
    "zh": [
      "需要完整分析、版本化交付及中文维护的项目任务。"
    ],
    "en": [
      "Project tasks needing complete analysis, versioned delivery and Chinese maintenance."
    ]
  },
  "rules": [
    "om.conclusion-first@1.1.0",
    "om.chinese-response@1.1.0",
    "om.bilingual-terms@1.1.0",
    "om.markdown-structure@1.1.0",
    "om.clean-deliverable@1.1.0",
    "om.concrete-titles@1.1.0",
    "om.response-dense@1.1.0",
    "om.evidence-inference@1.1.0",
    "om.test-evidence@1.1.0",
    "om.calculations@1.1.0",
    "om.complete-options@1.1.0",
    "om.align-requirements@1.1.0",
    "om.batch-questions@1.1.0",
    "om.assumptions-authority@1.1.0",
    "om.solutions-three-level@1.1.0",
    "om.versioned-files@1.1.0",
    "om.device-readable@1.1.0",
    "om.semantic-wrap@1.1.0",
    "om.editable-diagrams@1.1.0",
    "om.consistent-items@1.1.0",
    "om.report-context@1.1.0",
    "om.report-formats@1.1.0",
    "om.report-review@1.1.0",
    "om.tables-list-first@1.1.0",
    "om.portable-files@1.1.0",
    "om.rules-tools@1.1.0",
    "om.maintenance-chinese@1.1.0"
  ],
  "loading": {
    "always": [
      "om.chinese-response",
      "om.conclusion-first",
      "om.response-dense",
      "om.evidence-inference",
      "om.bilingual-terms",
      "om.markdown-structure",
      "om.batch-questions",
      "om.align-requirements",
      "om.clean-deliverable",
      "om.tables-list-first"
    ],
    "tags": [
      {
        "id": "decisions",
        "name": {
          "zh": "方案与论证",
          "en": "Options and reasoning"
        },
        "trigger": {
          "zh": "给方案、做比较、算数字、转述实测或依赖假设时",
          "en": "Proposing or comparing options, computing numbers, relaying test results, or relying on assumptions"
        },
        "exclude": {
          "zh": "纯执行类回复",
          "en": "Pure execution"
        }
      },
      {
        "id": "files",
        "name": {
          "zh": "文件与条目",
          "en": "Files and items"
        },
        "trigger": {
          "zh": "改文件、命名版本、拟标题或整理文档时",
          "en": "Editing or versioning files, writing titles, or organizing documents"
        },
        "exclude": {
          "zh": "对话回复",
          "en": "Chat replies"
        }
      },
      {
        "id": "reports",
        "name": {
          "zh": "汇报材料",
          "en": "Report materials"
        },
        "trigger": {
          "zh": "制作或审查汇报、PPT、HTML，含图表与排版时",
          "en": "Producing or reviewing reports, decks or HTML with charts and layout"
        },
        "exclude": {
          "zh": "闲聊与纯代码任务",
          "en": "Chat and pure coding tasks"
        }
      },
      {
        "id": "maintenance",
        "name": {
          "zh": "规则与模板维护",
          "en": "Rule and template upkeep"
        },
        "trigger": {
          "zh": "编写或维护 Skill、规则、模板时",
          "en": "Writing or maintaining skills, rules or templates"
        },
        "exclude": {
          "zh": "代码与命令标识符",
          "en": "Code and command identifiers"
        }
      }
    ],
    "members": {
      "om.calculations": [
        "decisions"
      ],
      "om.complete-options": [
        "decisions"
      ],
      "om.solutions-three-level": [
        "decisions"
      ],
      "om.assumptions-authority": [
