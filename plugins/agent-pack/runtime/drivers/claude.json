{
  "schema_version": 2,
  "id": "claude",
  "display": "Claude Code",
  "detect": {
    "executables": [
      "claude"
    ],
    "dirs": [
      {
        "path": "~/.claude",
        "env": "CLAUDE_CONFIG_DIR"
      }
    ]
  },
  "distribution": "marketplace-cli",
  "stores": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.claude/skills",
        "format": "dir",
        "write_target": true,
        "managed_by": "agent-pack-state"
      },
      {
        "scope": "project",
        "path": "<project>/.claude/skills",
        "format": "dir",
        "write_target": true
      }
    ],
    "mcp": [
      {
        "scope": "user",
        "path": "~/.claude.json",
        "format": "json",
        "root_key": "mcpServers",
        "managed_by": "agent-pack-state"
      },
      {
        "scope": "local",
        "path": "~/.claude.json#projects",
        "format": "json",
        "root_key": "mcpServers"
      },
      {
        "scope": "project",
        "path": "<project>/.mcp.json",
        "format": "json",
        "root_key": "mcpServers"
      }
    ]
  },
  "capabilities": {
    "default_set": true,
    "read_only": false,
    "project_mcp_write": true
  },
  "precedence": [
    {
      "kind": "skills",
      "rule": "personal-over-project",
      "evidence": "file",
      "source_url": "https://code.claude.com/docs/en/skills",
      "when": {
        "scopes": [
          "user",
          "project"
        ],
        "match": "exact"
      },
      "winner": "user"
    },
    {
      "kind": "mcp",
      "rule": "local-over-project-over-user",
      "evidence": "file",
      "source_url": "https://code.claude.com/docs/en/mcp",
      "when": {
        "scopes": [
          "local"
        ],
        "match": "includes"
      },
      "winner": "local"
    },
    {
      "kind": "mcp",
      "rule": "project-approval-unknown",
      "evidence": "unknown",
      "source_url": "https://code.claude.com/docs/en/mcp"
    }
  ]
}
