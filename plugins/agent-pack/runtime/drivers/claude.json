{
  "schema_version": 2,
  "id": "claude",
  "display": "Claude Code",
  "detect": {
    "executables": [
      "claude"
    ],
    "dirs": [
      {
        "path": "~/.claude",
        "env": "CLAUDE_CONFIG_DIR"
      }
    ]
  },
  "distribution": {
    "type": "marketplace-cli",
    "source": "marketplace",
    "interactive": "none",
    "installed_state": "records-json",
    "config_dir": {
      "path": "~/.claude",
      "env": "CLAUDE_CONFIG_DIR"
    },
    "steps": {
      "add_source": [
        "{cli}",
        "plugin",
        "marketplace",
        "add",
        "{slug}"
      ],
      "install": [
        "{cli}",
        "plugin",
        "install",
        "{plugin}@{marketplace}"
      ],
      "update_source": [
        "{cli}",
        "plugin",
        "marketplace",
        "update",
        "{marketplace}"
      ],
      "update": [
        "{cli}",
        "plugin",
        "update",
        "{plugin}@{marketplace}"
      ]
    },
    "scope_flag": "--scope",
    "owned_dirs": [
      {
        "path": "~/.claude"
      },
      {
        "path": "~/.claude",
        "env": "CLAUDE_CONFIG_DIR"
      }
    ],
    "messages": {
      "recovery": "versioned-cache-keeps-old",
      "applied_recovery": "versioned-cache-keeps-old",
      "unchanged": "market-entry-version-same",
      "describe_update_source": "refresh-own-market",
      "describe_update": "update-plugin-to-version"
    }
  },
  "runtime_cache": [
    {
      "base": "~/.claude",
      "env": "CLAUDE_CONFIG_DIR",
      "glob": "plugins/cache/agenthelm/<plugin>/*"
    }
  ],
  "stores": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.claude/skills",
        "format": "dir",
        "write_target": true,
        "managed_by": "agent-pack-state"
      },
      {
        "scope": "project",
        "path": "<project>/.claude/skills",
        "format": "dir",
        "write_target": true
      }
    ],
    "mcp": [
      {
        "scope": "user",
        "path": "~/.claude.json",
        "format": "json",
        "root_key": "mcpServers",
        "managed_by": "agent-pack-state"
      },
      {
        "scope": "local",
        "path": "~/.claude.json#projects",
        "format": "json",
        "root_key": "mcpServers"
      },
      {
        "scope": "project",
        "path": "<project>/.mcp.json",
        "format": "json",
        "root_key": "mcpServers"
      }
    ]
  },
  "capabilities": {
    "default_set": true,
    "read_only": false,
    "project_mcp_write": true,
    "legacy_cleanup": true,
    "marketplace_update": true,
    "reinstall_rewrites_all": false,
    "market_pin": true,
    "user_mcp_write": true,
    "project_skill_write": true,
    "user_skill_write": true
  },
  "precedence": [
    {
      "kind": "skills",
      "rule": "personal-over-project",
      "evidence": "file",
      "source_url": "https://code.claude.com/docs/en/skills",
      "when": {
        "scopes": [
          "user",
          "project"
        ],
        "match": "exact"
      },
      "winner": "user"
    },
    {
      "kind": "mcp",
      "rule": "local-over-project-over-user",
      "evidence": "file",
      "source_url": "https://code.claude.com/docs/en/mcp",
      "when": {
        "scopes": [
          "local"
        ],
        "match": "includes"
      },
      "winner": "local"
    },
    {
      "kind": "mcp",
      "rule": "project-approval-unknown",
      "evidence": "unknown",
      "source_url": "https://code.claude.com/docs/en/mcp"
    }
  ],
  "hooks": {
    "events": {
      "session-start": "SessionStart",
      "prompt-submit": "UserPromptSubmit",
      "stop": "Stop"
    },
    "output": {
      "session-start": "hookSpecificOutput",
      "prompt-submit": "hookSpecificOutput",
      "stop": "hookSpecificOutput"
    },
    "stop_prompt": "on-completion",
    "shows_system_message": true,
    "config": {
      "format": "group-event-handlers",
      "plugin_file": "hooks/hooks.json"
    },
    "legacy_sniff": {
      "fallback": true
    }
  },
  "sync": {
    "write": "native-package",
    "package_dir": "~/.claude/agent-pack/plugins"
  },
  "mcp": {
    "adapter": "json",
    "write": "user-file",
    "manual_remove": [
      "claude",
      "mcp",
      "remove",
      "--scope",
      "{scope}",
      "{name}"
    ],
    "options": {
      "remote_url_key": "url",
      "remote_headers": "inline",
      "env_interpolation": "shell-env",
      "type_field_required": true,
      "type_names": {
        "streamable-http": "http"
      }
    }
  }
}
