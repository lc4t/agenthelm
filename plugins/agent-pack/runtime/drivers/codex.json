{
  "schema_version": 2,
  "id": "codex",
  "display": "Codex",
  "detect": {
    "executables": [
      "codex"
    ],
    "dirs": [
      {
        "path": "~/.codex",
        "env": "CODEX_HOME"
      }
    ]
  },
  "distribution": "marketplace-cli",
  "stores": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.codex/skills",
        "format": "dir"
      },
      {
        "scope": "user",
        "path": "~/.agents/skills",
        "format": "dir",
        "write_target": true
      },
      {
        "scope": "project",
        "path": "<project>/.agents/skills",
        "format": "dir",
        "write_target": true
      }
    ],
    "mcp": [
      {
        "scope": "user",
        "path": "~/.codex/config.toml",
        "format": "toml"
      },
      {
        "scope": "project",
        "path": "<project>/.codex/config.toml",
        "format": "toml"
      }
    ]
  },
  "capabilities": {
    "default_set": true,
    "read_only": false,
    "project_mcp_write": false
  }
}
