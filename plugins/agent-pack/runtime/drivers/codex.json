{
  "schema_version": 2,
  "id": "codex",
  "display": "Codex",
  "detect": {
    "executables": [
      "codex"
    ],
    "dirs": [
      {
        "path": "~/.codex",
        "env": "CODEX_HOME"
      }
    ]
  },
  "distribution": "marketplace-cli",
  "runtime_cache": [
    {
      "base": "~/.codex",
      "env": "CODEX_HOME",
      "glob": "plugins/cache/agenthelm/<plugin>/*"
    }
  ],
  "stores": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.codex/skills",
        "format": "dir"
      },
      {
        "scope": "user",
        "path": "~/.agents/skills",
        "format": "dir",
        "write_target": true
      },
      {
        "scope": "project",
        "path": "<project>/.agents/skills",
        "format": "dir",
        "write_target": true
      }
    ],
    "mcp": [
      {
        "scope": "user",
        "path": "~/.codex/config.toml",
        "format": "toml",
        "root_key": "mcp_servers"
      },
      {
        "scope": "project",
        "path": "<project>/.codex/config.toml",
        "format": "toml",
        "root_key": "mcp_servers",
        "trust_required": true
      }
    ]
  },
  "capabilities": {
    "default_set": true,
    "read_only": false,
    "project_mcp_write": false
  },
  "precedence": [
    {
      "kind": "skills",
      "rule": "both-load",
      "evidence": "file",
      "source_url": "https://learn.chatgpt.com/docs/build-skills"
    },
    {
      "kind": "mcp",
      "rule": "project-trust-unknown",
      "evidence": "unknown",
      "source_url": "https://learn.chatgpt.com/docs/extend/mcp?surface=cli"
    }
  ]
}
