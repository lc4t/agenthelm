{
  "schema_version": 2,
  "id": "codex",
  "display": "Codex",
  "detect": {
    "executables": [
      "codex"
    ],
    "dirs": [
      {
        "path": "~/.codex",
        "env": "CODEX_HOME"
      }
    ]
  },
  "distribution": {
    "type": "marketplace-cli",
    "source": "marketplace",
    "interactive": "none",
    "installed_state": "cache-dir-versioned",
    "config_dir": {
      "path": "~/.codex",
      "env": "CODEX_HOME"
    },
    "steps": {
      "add_source": [
        "{cli}",
        "plugin",
        "marketplace",
        "add",
        "{slug}"
      ],
      "install": [
        "{cli}",
        "plugin",
        "add",
        "{plugin}@{marketplace}"
      ],
      "update_source": [
        "{cli}",
        "plugin",
        "marketplace",
        "upgrade",
        "{marketplace}"
      ]
    },
    "owned_dirs": [
      {
        "path": "~/.agents"
      },
      {
        "path": "~/.codex",
        "env": "CODEX_HOME"
      }
    ],
    "cli_locations": [
      "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
      "~/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
      "~/.local/bin/codex",
      "/opt/homebrew/bin/codex",
      "/usr/local/bin/codex"
    ],
    "messages": {
      "recovery": "managed-by-client-no-backup",
      "unchanged": "market-not-pinned-here",
      "unchanged_next": "pin-market-ref",
      "describe_update_source": "upgrade-market-and-plugins"
    }
  },
  "runtime_cache": [
    {
      "base": "~/.codex",
      "env": "CODEX_HOME",
      "glob": "plugins/cache/agenthelm/<plugin>/*"
    }
  ],
  "stores": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.codex/skills",
        "format": "dir"
      },
      {
        "scope": "user",
        "path": "~/.agents/skills",
        "format": "dir",
        "write_target": true
      },
      {
        "scope": "project",
        "path": "<project>/.agents/skills",
        "format": "dir",
        "write_target": true
      }
    ],
    "mcp": [
      {
        "scope": "user",
        "path": "~/.codex/config.toml",
        "format": "toml",
        "root_key": "mcp_servers"
      },
      {
        "scope": "project",
        "path": "<project>/.codex/config.toml",
        "format": "toml",
        "root_key": "mcp_servers",
        "trust_required": true
      }
    ]
  },
  "capabilities": {
    "default_set": true,
    "read_only": false,
    "project_mcp_write": false,
    "legacy_cleanup": true,
    "marketplace_update": true,
    "reinstall_rewrites_all": false,
    "market_pin": false
  },
  "precedence": [
    {
      "kind": "skills",
      "rule": "both-load",
      "evidence": "file",
      "source_url": "https://learn.chatgpt.com/docs/build-skills"
    },
    {
      "kind": "mcp",
      "rule": "project-trust-unknown",
      "evidence": "unknown",
      "source_url": "https://learn.chatgpt.com/docs/extend/mcp?surface=cli"
    }
  ],
  "hooks": {
    "events": {
      "session-start": "SessionStart",
      "prompt-submit": "UserPromptSubmit",
      "stop": "Stop"
    },
    "output": {
      "session-start": "hookSpecificOutput",
      "prompt-submit": "hookSpecificOutput",
      "stop": "decision_block"
    },
    "stop_prompt": "on-completion",
    "config": {
      "format": "group-event-handlers",
      "plugin_file": "hooks/hooks.json"
    },
    "legacy_sniff": {
      "priority": 2,
      "payload_keys": [
        "turn_id"
      ],
      "env": [
        "PLUGIN_ROOT"
      ]
    }
  }
}
