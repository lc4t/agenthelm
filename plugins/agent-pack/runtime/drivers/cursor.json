{
  "schema_version": 2,
  "id": "cursor",
  "display": "Cursor",
  "detect": {
    "executables": [],
    "dirs": [
      {
        "path": "~/.cursor"
      }
    ]
  },
  "distribution": {
    "type": "directory-dropin",
    "source": "bundle-dir",
    "interactive": "none",
    "installed_state": "dropin-dir",
    "config_dir": {
      "path": "~/.cursor"
    },
    "messages": {
      "recovery": "dropin-backup-folder",
      "unchanged": "release-same-version-rewrote",
      "describe_dropin": "dropin-into-local-plugins",
      "unavailable_next": "use-source-or-ignore-client"
    }
  },
  "runtime_cache": [
    {
      "base": "~/.cursor",
      "glob": "plugins/local/<plugin>"
    }
  ],
  "stores": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.cursor/skills",
        "format": "dir",
        "write_target": true
      },
      {
        "scope": "user",
        "path": "~/.agents/skills",
        "format": "dir"
      },
      {
        "scope": "project",
        "path": "<project>/.cursor/skills",
        "format": "dir"
      },
      {
        "scope": "project",
        "path": "<project>/.agents/skills",
        "format": "dir",
        "write_target": true
      }
    ],
    "mcp": [
      {
        "scope": "user",
        "path": "~/.cursor/mcp.json",
        "format": "json",
        "root_key": "mcpServers"
      },
      {
        "scope": "project",
        "path": "<project>/.cursor/mcp.json",
        "format": "json",
        "root_key": "mcpServers"
      }
    ]
  },
  "capabilities": {
    "default_set": true,
    "read_only": false,
    "project_mcp_write": false,
    "legacy_cleanup": false,
    "marketplace_update": false,
    "reinstall_rewrites_all": true,
    "market_pin": false,
    "user_mcp_write": true,
    "project_skill_write": false,
    "user_skill_write": true
  },
  "precedence": [
    {
      "kind": "skills",
      "rule": "precedence-undocumented",
      "evidence": "unknown",
      "source_url": null
    },
    {
      "kind": "mcp",
      "rule": "precedence-undocumented",
      "evidence": "unknown",
      "source_url": null
    }
  ],
  "compat_reads": {
    "skills": [
      {
        "scope": "user",
        "path": "~/.claude/skills",
        "status": "documented",
        "source_url": "https://cursor.com/docs/skills"
      },
      {
        "scope": "user",
        "path": "~/.codex/skills",
        "status": "documented",
        "source_url": "https://cursor.com/docs/skills"
      },
      {
        "scope": "project",
        "path": "<project>/.claude/skills",
        "status": "documented",
        "source_url": "https://cursor.com/docs/skills"
      },
      {
        "scope": "project",
        "path": "<project>/.codex/skills",
        "status": "documented",
        "source_url": "https://cursor.com/docs/skills"
      }
    ]
  },
  "hooks": {
    "events": {
      "session-start": "sessionStart",
      "stop": "stop"
    },
    "output": {
      "session-start": "additional_context",
      "stop": "followup_message"
    },
    "stop_prompt": "off",
    "stop_status_gated": true,
    "config": {
      "format": "flat-event-commands",
      "user": "~/.cursor/hooks.json",
      "project": "<project>/.cursor/hooks.json"
    },
    "legacy_sniff": {
      "priority": 1,
      "payload_keys": [
        "workspace_roots",
        "conversation_id"
      ]
    }
  },
  "unsupported": [
    {
      "feature": "hook-event:prompt-submit",
      "reason": "agenthelm wires no prompt-submit hook for Cursor (unchanged since the first nudge release)"
    }
  ],
  "sync": {
    "write": "plugin-dir",
    "package_dir": "~/.cursor/plugins/local"
  },
  "mcp": {
    "adapter": "json",
    "write": "package",
    "options": {
      "remote_url_key": "url",
      "remote_headers": "inline",
      "env_interpolation": "declared-variables",
      "type_field_required": true
    }
  }
}
