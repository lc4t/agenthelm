#!/usr/bin/env python3
"""A stand-in for the Antigravity ``agy`` command line, for tests only.

It answers the few commands agenthelm uses and keeps its state under ``$HOME/.stub-agy`` (never in a real agy
location). ``plugin install <dir>`` copies the directory into ``$HOME/.gemini/config/plugins/<name>``; ``plugin list
--json`` reports what was installed (``enabled``, ``version``, ``path``, ``skills``, ``mcpServers``, ``hooks``). Every call
is appended to ``$AGY_STUB_LOG`` (one line, the arguments) so a test can assert the exact command lines.
"""
import json
import os
import shutil
import sys
from pathlib import Path

home = Path(os.environ["HOME"])
state_file = home / ".stub-agy" / "state.json"
plugins_dir = home / ".gemini" / "config" / "plugins"
args = sys.argv[1:]
log = os.environ.get("AGY_STUB_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(" ".join(args) + "\n")


def load() -> dict:
    return json.loads(state_file.read_text()) if state_file.is_file() else {}


def save(state: dict) -> None:
    state_file.parent.mkdir(parents=True, exist_ok=True)
    state_file.write_text(json.dumps(state))


def fail(message: str, code: int = 1) -> None:
    sys.stderr.write(message + "\n")
    raise SystemExit(code)


if args == ["--version"]:
    print("1.5.14")
elif args[:2] == ["plugin", "list"]:
    if os.environ.get("AGY_STUB_LIST_FAIL"):
        fail("list failed")
    rows = []
    for name, info in sorted(load().items()):
        path = plugins_dir / name
        manifest = json.loads((path / "plugin.json").read_text()) if (path / "plugin.json").is_file() else {}
        row = {"name": name, "enabled": info["enabled"], "version": manifest.get("version", ""), "path": str(path),
               "skills": sorted(p.name for p in (path / "skills").glob("*") if p.is_dir()), "source": "antigravity"}
        if (path / "mcp_config.json").is_file():
            row["mcpServers"] = sorted(json.loads((path / "mcp_config.json").read_text()).get("mcpServers", {}))
        if (path / "hooks.json").is_file():
            row["hooks"] = sorted(json.loads((path / "hooks.json").read_text()))
        rows.append(row)
    print(json.dumps(rows))
elif args[:2] == ["plugin", "install"] and len(args) == 3:
    if os.environ.get("AGY_STUB_INSTALL_FAIL"):
        fail("install failed")
    source = Path(args[2])
    if not (source / "plugin.json").is_file():
        fail(f"no plugin.json in {source}")
    name = json.loads((source / "plugin.json").read_text())["name"]
    state = load()
    if name in state:
        fail(f"plugin {name} is already installed")
    target = plugins_dir / name
    shutil.copytree(source, target)
    state[name] = {"enabled": True}
    save(state)
elif args[:2] == ["plugin", "uninstall"] and len(args) == 3:
    if os.environ.get("AGY_STUB_UNINSTALL_FAIL"):
        fail("uninstall failed")
    state = load()
    if args[2] not in state:
        fail(f"plugin {args[2]} is not installed")
    shutil.rmtree(plugins_dir / args[2], ignore_errors=True)
    del state[args[2]]
    save(state)
elif args[:2] in (["plugin", "enable"], ["plugin", "disable"]) and len(args) == 3:
    state = load()
    if args[2] not in state:
        fail(f"plugin {args[2]} is not installed")
    state[args[2]]["enabled"] = args[1] == "enable"
    save(state)
else:
    fail(f"stub agy: unsupported arguments: {args}", 2)
