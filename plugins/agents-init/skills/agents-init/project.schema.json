{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill.sakanano.moe/skills/agents-init/project.schema.json",
  "title": "agents-init Project Profile",
  "description": "由 project-orchestrator、agent-pack 与 opinion-manager 消费的可移植项目发现契约，位于 .agents/moe.sakanano.agent-pack/project.json。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "profile", "runtime", "opinion", "capabilities", "work", "privacy"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schema_version": {"const": "1.0"},
    "initializer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["project_type", "vcs", "stack", "runtime", "agent_cli"],
      "properties": {
        "project_type": {"$ref": "#/$defs/stringArray"},
        "vcs": {"type": "string", "minLength": 1},
        "stack": {"$ref": "#/$defs/stringArray"},
        "runtime": {"type": "string", "minLength": 1},
        "agent_cli": {"$ref": "#/$defs/stringArray"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill", "plugin", "capability_manager", "required", "commit_policy", "push_policy"],
      "properties": {
        "skill": {"const": "project-orchestrator"},
        "plugin": {"const": "project-orchestrator"},
        "capability_manager": {"const": "agent-pack"},
        "distribution": {"enum": ["marketplace", "bundled", "external"]},
        "required": {"type": "boolean"},
        "commit_policy": {"enum": ["explicit", "project-policy"]},
        "push_policy": {"enum": ["explicit", "project-policy"]}
      }
    },
    "opinion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "project_overlay", "strict_mode"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "project_overlay": {"type": ["string", "null"]},
        "strict_mode": {"enum": ["smart", "strict", "disabled"]},
        "loading_mode": {"enum": ["tiered", "full"]}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider"],
      "properties": {
        "provider": {"enum": ["project-orchestrator", "project"]},
        "root": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "index_command": {"type": ["string", "null"]},
        "check_command": {"type": ["string", "null"]},
        "policy": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_roots", "plugin_dirs", "skill_roots", "mcp_sources", "destination_skill_root", "destination_mcp"],
      "properties": {
        "plugin_roots": {"$ref": "#/$defs/pathArray"},
        "plugin_dirs": {"$ref": "#/$defs/pathArray"},
        "skill_roots": {"$ref": "#/$defs/pathArray"},
        "mcp_sources": {"$ref": "#/$defs/pathArray"},
        "native_mcp_sources": {"$ref": "#/$defs/pathArray"},
        "credential_env_file": {
          "anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]
        },
        "mcp_client_policy": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "include": {"$ref": "#/$defs/stringArray"},
              "exclude": {"$ref": "#/$defs/stringArray"}
            },
            "not": {"required": ["include", "exclude"]}
          }
        },
        "destination_skill_root": {"$ref": "#/$defs/relativePath"},
        "destination_mcp": {"$ref": "#/$defs/relativePath"}
      }
    },
    "work": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "mode": {"enum": ["case-workspace", "legacy"]},
        "task": {"type": ["object", "null"]},
        "legacy_task": {"type": ["object", "null"]},
        "case": {
          "type": ["object", "null"], "additionalProperties": true,
          "properties": {
            "root": {"$ref": "#/$defs/relativePath"},
            "artifact_mode": {"enum": ["case-local", "external-references"]}
          }
        },
        "assets": {
          "type": ["object", "null"], "additionalProperties": true,
          "properties": {
            "roots": {"$ref": "#/$defs/pathArray"}
          }
        }
      }
    },
    "entry": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "人用入口：不经过 AI Agent 打开项目菜单。缺省时仍可用 agenthelm project。",
      "properties": {
        "api": {"type": "integer", "minimum": 1, "description": "项目入口的接口版本；运行时不支持时启动器提示更新"},
        "launcher": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "根目录启动器的文件名"},
        "about": {"type": "string"},
        "guide": {"$ref": "#/$defs/relativePath"},
        "tools": {"$ref": "#/$defs/relativePath"},
        "where": {
          "type": "array",
          "items": {"type": "object", "required": ["label", "path"],
                    "properties": {"label": {"type": "string"}, "path": {"type": "string"}}}
        },
        "start": {"$ref": "#/$defs/stringArray"},
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["command"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "write": {"type": "boolean"},
            "status_map": {
              "type": "object",
              "additionalProperties": {"enum": ["active", "waiting", "captured", "suspended", "done", "abandoned"]}
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["forbidden_default_reads", "generated_outputs"],
      "properties": {
        "forbidden_default_reads": {"$ref": "#/$defs/pathArray"},
        "generated_outputs": {"$ref": "#/$defs/pathArray"}
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:/|~|[A-Za-z]:[\\\\/])"}
    },
    "pathArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/relativePath"},
      "uniqueItems": true
    }
  }
}
