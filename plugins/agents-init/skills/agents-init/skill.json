{
  "id": "agents-init",
  "name": "agents-init v6 / Project Profile 初始化与迁移",
  "description": "创建或迁移通用项目骨架与 Project Profile；随包 opinion-manager 管理用户确认的 Agent 行为规则。",
  "schema_version": "1.0",
  "version": "6.5.0",
  "status": "stable",
  "language": "zh-CN",
  "license": "MIT",
  "created_at": "2026-07-02",
  "updated_at": "2026-10-08",
  "authors": [
    {
      "name": "lc4t"
    }
  ],
  "tags": [
    "agents",
    "project-init",
    "project-profile",
    "agent-plugins",
    "codex",
    "claude-code",
    "cursor"
  ],
  "template": {
    "path": "./AGENT.template.md",
    "version": "v6.4",
    "title": "AGENT.template.md v6.4",
    "design_principle": "初始化、生命周期编排、扩展能力管理、Opinion 管理与领域交付职责分离。"
  },
  "entrypoints": {
    "browser": "./index.html",
    "agent": "./SKILL.md",
    "metadata": "./skill.json",
    "template": "./AGENT.template.md",
    "initializer": "./scripts/init_project.py"
  },
  "files": [
    {
      "path": "./SKILL.md",
      "role": "agent-entry",
      "required": true
    },
    {
      "path": "./AGENT.template.md",
      "role": "skeleton-contract",
      "required": true
    },
    {
      "path": "./scripts/init_project.py",
      "role": "deterministic-initializer",
      "required": true
    },
    {
      "path": "./project.schema.json",
      "role": "project-profile-schema",
      "required": true
    },
    {
      "path": "./index.html",
      "role": "browser-page",
      "required": true
    },
    {
      "path": "./skill.json",
      "role": "metadata",
      "required": true
    }
  ],
  "commands": [
    {
      "id": "init",
      "triggers": [
        "初始化项目",
        "生成 AGENTS.md",
        "创建 Project Profile"
      ],
      "description": "扫描仓库、预览冲突并在确认后创建 v6 骨架。"
    },
    {
      "id": "migrate",
      "triggers": [
        "迁移 agents-init",
        "升级项目 Agent 结构",
        "从 project-runtime 迁移"
      ],
      "description": "保留现有项目事实和工作数据，把 v5 Profile 升级到 v6 并迁移职责边界。"
    }
  ],
  "outputs": [
    "AGENTS.md",
    "AGENT.RULES.md",
    "OPINION.md",
    "CLAUDE.md",
    "AGENT.md",
    ".agents/plugin.json",
    ".agents/mcp.json",
    ".agents/moe.sakanano.agent-pack/project.json",
    ".agent-doc/",
    "memory/"
  ],
  "privacy": {
    "personal_global_rules_included": false,
    "credentials_included": false,
    "project_opinion_placeholder_only": true,
    "public_opinion_templates_included": true
  },
  "compatibility": {
    "agent_plugins": "1.0.0",
    "project_orchestrator": "companion plugin project-orchestrator",
    "agent_pack": "companion plugin agent-pack",
    "opinion_manager": "companion plugin opinion-manager"
  },
  "distribution": {
    "plugin_manifest": "../../plugin.json",
    "lifecycle_skill": "../../../project-orchestrator/skills/project-orchestrator/SKILL.md",
    "capability_skill": "../../../agent-pack/skills/agent-pack/SKILL.md",
    "opinion_skill": "../../../opinion-manager/skills/opinion-manager/SKILL.md",
    "install_unit": "marketplace"
  }
}
